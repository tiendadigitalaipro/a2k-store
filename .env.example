# A2K Store — Variables de entorno de ejemplo
# Copia este archivo como .env.local y rellena los valores reales.
# NUNCA commitees archivos .env con secretos.

# Supabase
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# WhatsApp (formato internacional sin +)
VITE_WHATSAPP_NUMBER=584164117331

# Resend (email)
# RESEND_API_KEY=re_your_key_here

# WhatsApp Cloud API (Meta)
# WHATSAPP_ACCESS_TOKEN=your_token
# WHATSAPP_PHONE_NUMBER_ID=your_phone_id
